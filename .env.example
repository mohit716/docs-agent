AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.2
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1

# Long-term key from the Bedrock console: API keys → Generate long-term API keys.
# Shown only once. Do not commit the real value.
AWS_BEARER_TOKEN_BEDROCK=

# Optional AWS Secrets Manager JSON secret. Values in this secret are used
# only when the matching environment variable is not already set.
DOCS_AGENT_SECRET_ID=

# Postgres on Amazon RDS. When RDS_HOST is set, notes and chat history
# are stored there. Leave it blank to keep notes in data/notes.json.
RDS_HOST=
RDS_PORT=5432
RDS_DB=postgres
RDS_USER=postgres
RDS_PASSWORD=

# Optional SQS document-processing worker configuration.
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/docs-agent-documents
SQS_QUEUE_URL=
OCR_OUTPUT_PREFIX=extracted/
